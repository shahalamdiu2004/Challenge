    "import pandas as pd\n",
    "data= pd.read_excel(\"Challenge-106-Latest Data.xlsx\")\n",
    "df= pd.DataFrame(data)\n",
    "result= df.groupby(\"Shop\").tail(1).sort_values(\"Shop\")[[\"Shop\",\"Price\",\"Date\"]]\n",
    "\n",
    "print (result.to_string(index=False))"

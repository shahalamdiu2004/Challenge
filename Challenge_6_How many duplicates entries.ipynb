   "source": [
    "import pandas as pd\n",
    "\n",
    "data= pd.read_excel(\"Challenge-6-How many duplicates entries.xlsx\")\n",
    "\n",
    "df= pd.DataFrame(data)\n",
    "result= df.groupby([\"Data\",\"Alpha\"]).size().groupby([\"Data\"]).size()\n",
    "\n",
    "result= result[result>1].reset_index()[[\"Data\"]]\n",
    "print(result[\"Data\"].to_string(index=False))"
   ]

   "source": [
    "import pandas as pd\n",
    "\n",
    "data= pd.read_excel(\"Challenge-4-Find Words All Capitals.xlsx\")\n",
    "\n",
    "df= pd.DataFrame(data)\n",
    "\n",
    "words= df.iloc[:,0].str.split()\n",
    "\n",
    "result= words.apply(lambda x:\n",
    "            \" \".join(i for i in x\n",
    "             if i== i.upper()))\n",
    "\n",
    "result"
   ]
